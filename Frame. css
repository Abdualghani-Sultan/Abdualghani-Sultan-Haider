
/* تنسيق الصفحة الرئيسية */
* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0f4f8;
    color: #333;
    margin: 0;
    padding: 20px;
    direction: rtl;
    line-height: 1.8;
}

/* رأس الصفحة */
header {
    background: linear-gradient(135deg, #123456, #2874a6);
    color: white;
    text-align: center;
    padding: 35px 20px;
    border-radius: 15px;
}

/* العناوين */
h1, h2, h3, h4, h6 {
    color: #164e75;
}

header h1 {
    color: white;
}

/* الأقسام */
main {
    max-width: 900px;
    margin: 25px auto;
}

section {
    background-color: white;
    padding: 25px;
    margin-bottom: 20px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}

/* الصورة الشخصية */
img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #2874a6;
    display: block;
    margin: 20px auto;
}

/* الروابط */
a {
    color: #1673a5;
    text-decoration: none;
    font-weight: bold;
}

a:hover {
    color: #e67e22;
    text-decoration: underline;
}

/* القوائم */
ul, ol {
    padding-right: 30px;
}

/* نهاية الصفحة */
footer {
    background-color: #123456;
    color: white;
    text-align: center;
    padding: 20px;
    border-radius: 12px;
}

/* الهواتف */
@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    section {
        padding: 15px; 
    }

    img {
        width: 160px;
        height: 160px;
    }
}

