
/* General Page Settings */

* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0f4f8;
    color: #333333;
    margin: 0;
    padding: 20px;
    direction: rtl;
    line-height: 1.8;
}

/* Header Section */

header {
    background: linear-gradient(135deg, #123456, #2874a6);
    color: white;
    text-align: center;
    padding: 35px 20px;
    border-radius: 15px;
    margin-bottom: 25px;
}

header h1 {
    color: white;
    font-size: 32px;
}

/* Main Content */

main {
    max-width: 900px;
    margin: 25px auto;
}

/* Content Sections */

section {
    background-color: white;
    padding: 25px;
    margin-bottom: 20px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

/* Headings */

h1, h2, h3, h4, h6 {
    color: #164e75;
}

h2 {
    border-bottom: 2px solid #2874a6;
    padding-bottom: 8px;
}

/* Paragraphs */

p {
    font-size: 17px;
    line-height: 1.9;
}

/* Personal Image */

img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #2874a6;
    display: block;
    margin: 20px auto;
}

/* Links */

a {
    color: #1673a5;
    text-decoration: none;
    font-weight: bold;
}

a:hover {
    color: #e67e22;
    text-decoration: underline;
}

/* Lists */

ul, ol {
    padding-right: 30px;
}

li {
    margin-bottom: 8px;
}

/* Strong Text */

strong {
    color: #123456;
}

/* Footer */

footer {
    background-color: #123456;
    color: white;
    text-align: center;
    padding: 20px;
    border-radius: 12px;
    margin-top: 25px;
}

footer p {
    color: white;
}

/* Mobile Responsive Design */

@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    header {
        padding: 25px 10px;
    }

    header h1 {
        font-size: 25px;
    }

    section {
        padding: 15px;
    }

    img {
        width: 160px;
        height: 160px;
    }
}
